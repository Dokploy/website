{
	"name": "website",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"docs:dev": "pnpm --filter=docs run dev",
		"docs:build": "pnpm --filter=docs run build",
		"docs:typecheck": "pnpm --filter=docs run typecheck",
		"website:dev": "pnpm --filter=website run dev",
		"website:build": "pnpm --filter=website run build",
		"website:typecheck": "pnpm --filter=website run typecheck",
		"typecheck": "pnpm -r run typecheck",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@types/node": "^20.9.0",
		"lint-staged": "^15.2.7"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=10.22.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"commitlint": {
		"extends": ["@commitlint/config-conventional"]
	},
	"resolutions": {
		"@babel/core@<7.29.6": "^7.29.6",
		"@babel/helpers@<7.26.10": "^7.26.10",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"axios@<1.20.0": "^1.20.0",
		"baseline-browser-mapping@<2.11.0": "^2.11.0",
		"brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
		"browserslist@<4.28.7": "^4.28.7",
		"fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
		"fflate@>=0.7.0 <0.7.5": "~0.7.5",
		"follow-redirects@<1.16.0": "^1.16.0",
		"glob@>=10.2.0 <10.5.0": "^10.5.0",
		"image-size@>=0.6.3 <2.0.3": "^2.0.3",
		"js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
		"mdast-util-to-hast@>=13.0.0 <13.2.1": "^13.2.1",
		"minimatch@>=9.0.0 <9.0.7": "^9.0.7",
		"nanoid@<3.3.18": "^3.3.18",
		"openapi-sampler@<1.7.6": "^1.7.6",
		"path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
		"picomatch@<2.3.2": "^2.3.2",
		"picomatch@>=4.0.0 <4.0.4": "^4.0.4",
		"postcss-selector-parser@>=6.1.0 <6.1.5": "^6.1.5",
		"postcss-selector-parser@>=7.1.0 <7.1.6": "^7.1.6",
		"postcss@<8.5.23": "^8.5.23",
		"source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
		"yaml@>=2.0.0 <2.8.3": "^2.8.3"
	}
}
